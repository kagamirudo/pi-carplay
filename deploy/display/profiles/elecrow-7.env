# Elecrow RC070 / Waveshare 7inch HDMI LCD (C). Native 1024x600, no UI scale.
# Android Auto is asked for 720p and scaled down; 480p is softer on this panel.
PROFILE=elecrow-7
SCALE=1
FORCE_W=1024
FORCE_H=600
AA_RES=2
AA_DPI=160
AA_MARGIN_W=0
AA_MARGIN_H=0
CMDLINE_EXTRA="video=HDMI-A-1:1024x600@60e drm.edid_firmware=HDMI-A-1:edid/elecrow-1024x600.bin"
USB_MAX_CURRENT=1
KANSHI_MODE="mode 1024x600 scale 1"

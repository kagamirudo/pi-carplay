# Android Open Accessory (AOAP) modes. After the phone switches to accessory
# mode it re-enumerates as 18d1:2d00..2d05. The logged-in desktop user (uaccess)
# and the plugdev group may open it; nobody else.
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", MODE="0660", GROUP="plugdev", TAG+="uaccess"

#!/bin/sh
# Per-user setup after installing the pi-carplay package.
#
#   pi-carplay-setup          labwc touch calibration + autostart for this user
#   pi-carplay-setup --boot   also add the display overlay to config.txt (sudo)
set -eu

SHARE=${PI_CARPLAY_SHARE:-/opt/pi-carplay/share}
LABWC_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/labwc"

if [ "$(id -u)" -eq 0 ]; then
  echo "Run pi-carplay-setup as the desktop user, not root." >&2
  exit 1
fi

mkdir -p "$LABWC_DIR"
for f in rc.xml autostart; do
  if [ -f "$LABWC_DIR/$f" ] && ! cmp -s "$LABWC_DIR/$f" "$SHARE/labwc/$f"; then
    cp "$LABWC_DIR/$f" "$LABWC_DIR/$f.bak"
    echo "Backed up $LABWC_DIR/$f to $f.bak"
  fi
  cp "$SHARE/labwc/$f" "$LABWC_DIR/$f"
done
echo "Installed labwc touch calibration and autostart in $LABWC_DIR"

# The packaged unit is a template. Fill in this user here, not at package
# build time, because the package is built as root.
UNIT_SRC="${PI_CARPLAY_UNIT:-/usr/share/pi-carplay/pi-carplay-dashcam.service}"
if [ -f "$UNIT_SRC" ]; then
  unit_dir="${XDG_STATE_HOME:-$HOME/.local/share}/pi-carplay"
  mkdir -p "$unit_dir"
  sed -e "s|@USER@|$(id -un)|g" \
      -e "s|@UID@|$(id -u)|g" \
      -e "s|@BIN_DIR@|/usr/bin|g" \
      "$UNIT_SRC" > "$unit_dir/pi-carplay-dashcam.service"
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    state=$(SYSTEMD_COLORS=0 systemctl is-system-running 2>/dev/null || true)
    case "$state" in
      running|degraded|starting|initializing|maintenance)
        sudo install -m 0644 "$unit_dir/pi-carplay-dashcam.service" /etc/systemd/system/pi-carplay-dashcam.service
        sudo systemctl daemon-reload
        ;;
    esac
  fi
  echo "Rendered the dashcam unit for $(id -un)"
fi

if [ "${1:-}" = "--boot" ]; then
  "${PI_CARPLAY_BOOT_CONFIG:-/usr/bin/pi-carplay-boot-config}"
fi

echo
echo "Log out and back in (or reboot) to start the head unit."

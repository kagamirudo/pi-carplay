+// Optional colour correction for the panel. Neutral by default: on the SPI
+// TN panel, darkened mid-tones shifted orange to red and greys to blue.
+class PanelColorEffect : public QGraphicsEffect
+{
+public:
+    static bool wanted()
+    {
+        return envOr("OPENAUTO_PANEL_GAMMA", 1.0) != 1.0 || envOr("OPENAUTO_PANEL_CONTRAST", 1.0) != 1.0
+            || envOr("OPENAUTO_PANEL_SATURATION", 1.0) != 1.0;
+    }
+
+    explicit PanelColorEffect(QObject* parent = nullptr)
+        : QGraphicsEffect(parent)
+        , saturation_(envOr("OPENAUTO_PANEL_SATURATION", 1.0))
+    {
+        const double gamma = envOr("OPENAUTO_PANEL_GAMMA", 1.0);
+        const double contrast = envOr("OPENAUTO_PANEL_CONTRAST", 1.0);
+        for(int i = 0; i < 256; ++i)
+        {
+            double v = std::pow(i / 255.0, gamma);
+            v = (v - 0.5) * contrast + 0.5;
+            lut_[i] = static_cast<int>(std::lround(qBound(0.0, v, 1.0) * 255.0));
+        }
+        OPENAUTO_LOG(info) << "[QtVideoOutput] panel color gamma " << gamma
+                           << " contrast " << contrast << " saturation " << saturation_;
+    }
+
+protected:
+    void draw(QPainter* painter) override
+    {
+        QPoint offset;
+        const QPixmap source = sourcePixmap(Qt::DeviceCoordinates, &offset, QGraphicsEffect::NoPad);
+        if(source.isNull())
+        {
+            return;
+        }
+
+        QImage image = source.toImage().convertToFormat(QImage::Format_RGB32);
+        const int sat = static_cast<int>(std::lround(saturation_ * 256.0));
+        for(int y = 0; y < image.height(); ++y)
+        {
+            QRgb* line = reinterpret_cast<QRgb*>(image.scanLine(y));
+            for(int x = 0; x < image.width(); ++x)
+            {
+                const int r = lut_[qRed(line[x])];
+                const int g = lut_[qGreen(line[x])];
+                const int b = lut_[qBlue(line[x])];
+                const int luma = (r * 77 + g * 150 + b * 29) >> 8;
+                line[x] = qRgb(qBound(0, luma + (((r - luma) * sat) >> 8), 255),
+                               qBound(0, luma + (((g - luma) * sat) >> 8), 255),
+                               qBound(0, luma + (((b - luma) * sat) >> 8), 255));
+            }
+        }
+
+        painter->save();
+        painter->setWorldTransform(QTransform());
+        painter->drawImage(offset, image);
+        painter->restore();
+    }
+
+private:
+    std::array<int, 256> lut_{};
+    double saturation_;
+};
+

+    if(contentW > 0 && contentH > 0 && (margins.width() > 0 || margins.height() > 0))
+    {
+        videoView_->setSceneRect(cropX, cropY, contentW, contentH);
+    }
+    else
+    {
+        videoView_->setSceneRect(0, 0, frame.width(), frame.height());
+    }
+
+    // Uniform downscale of the phone's content area onto the panel.
+    QSize panel(480, 320);
+    if(QScreen* screen = QGuiApplication::primaryScreen())
+    {
+        panel = screen->geometry().size();
+    }
+    const QRectF shown = videoView_->sceneRect();
+    const qreal scale = std::min(panel.width() / shown.width(), panel.height() / shown.height());
+    videoView_->setTransform(QTransform::fromScale(scale, scale));
+    OPENAUTO_LOG(info) << "[QtVideoOutput] scale " << scale << " content " << videoView_->sceneRect().x()
+                       << "," << videoView_->sceneRect().y()
+                       << " " << videoView_->sceneRect().width()
+                       << "x" << videoView_->sceneRect().height()
+                       << " from " << frame.width() << "x" << frame.height();

+void QtVideoOutput::showNativeCrop()
+{
+    const QSize frame = this->videoFrameSize();
+    const QRect margins = configuration_->getVideoMargins();
+    const int contentW = frame.width() - margins.width();
+    const int contentH = frame.height() - margins.height();
+    const int cropX = std::max(0, margins.width() / 2);
+    const int cropY = std::max(0, margins.height() / 2);
+
+    videoItem_->setSize(QSizeF(frame));
+    videoItem_->setPos(0, 0);
+    videoScene_->setSceneRect(0, 0, frame.width(), frame.height());

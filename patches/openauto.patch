+double envOr(const char* name, double fallback)
+{
+    const char* value = std::getenv(name);
+    if(value == nullptr || *value == '\0')
+    {
+        return fallback;
+    }
+    char* end = nullptr;
+    const double parsed = std::strtod(value, &end);
+    return end == value ? fallback : parsed;
+}

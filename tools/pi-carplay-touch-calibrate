#!/bin/bash
# Calibrate the ADS7846 resistive touchscreen. The matrix goes in a udev rule
# (LIBINPUT_CALIBRATION_MATRIX), so it applies to labwc, the shell and Android
# Auto alike, and survives reboots. Run as the desktop user on the Pi.
#
#   pi-carplay-touch-calibrate                     tap 5 crosses on the panel, then apply
#   pi-carplay-touch-calibrate --dry-run           tap the crosses, print the result, change nothing
#   pi-carplay-touch-calibrate --matrix 'a b c d e f'   apply a known matrix
#   pi-carplay-touch-calibrate --reset             back to the shipped default
#   pi-carplay-touch-calibrate --show              what is configured and active
#
# Options: --timeout SECONDS per cross (default 60), --device /dev/input/eventN.
# Exit codes: 0 applied (or shown), 1 usage/error, 2 no touch device,
# 3 no tap in time, 4 taps did not line up. On a non-zero exit nothing changed.
set -euo pipefail

# Shipped default: the hat's raw Y axis runs bottom to top.
DEFAULT_MATRIX="1 0 0 0 -1 1"
DEVICE_NAME="ADS7846 Touchscreen"
RULE=${PI_CARPLAY_TOUCH_RULE:-/etc/udev/rules.d/99-pi-carplay-touch.rules}
LABWC_RC=${LABWC_RC:-${XDG_CONFIG_HOME:-$HOME/.config}/labwc/rc.xml}
NO_RELOAD=${PI_CARPLAY_NO_RELOAD:-0}
if [ -z "${SUDO+x}" ]; then
  SUDO=sudo
  [ "$(id -u)" -eq 0 ] && SUDO=
fi

usage() { sed -n '2,15s/^# \{0,1\}//p' "$0"; }
die() { echo "pi-carplay-touch-calibrate: $*" >&2; exit 1; }

mode=calibrate
dry_run=0
matrix=
timeout=60
device=
while [ $# -gt 0 ]; do
  case "$1" in
    --show) mode=show ;;
    --reset) mode=apply; matrix=$DEFAULT_MATRIX ;;
    --matrix) [ $# -ge 2 ] || die "--matrix needs 'a b c d e f'"; mode=apply; matrix=$2; shift ;;
    --dry-run) dry_run=1 ;;
    --timeout) [ $# -ge 2 ] || die "--timeout needs seconds"; timeout=$2; shift ;;
    --device) [ $# -ge 2 ] || die "--device needs a path"; device=$2; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
  shift
done
[[ "$timeout" =~ ^[1-9][0-9]*$ ]] || die "--timeout must be a whole number of seconds"

# Six plain decimal numbers, normalised to single spaces; anything else is refused.
valid_matrix() {
  local -a v
  read -r -a v <<< "$1"
  [ "${#v[@]}" -eq 6 ] || return 1
  local n
  for n in "${v[@]}"; do
    [[ "$n" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || return 1
  done
  echo "${v[*]}"
}

touch_node() {
  if [ -n "$device" ]; then echo "$device"; return; fi
  local d
  for d in /sys/class/input/event*; do
    [ "$(cat "$d/device/name" 2>/dev/null)" = "$DEVICE_NAME" ] && { echo "/dev/input/${d##*/}"; return; }
  done
  return 0
}

rule_matrix() { sed -n 's/.*LIBINPUT_CALIBRATION_MATRIX}="\([^"]*\)".*/\1/p' "$RULE" 2>/dev/null | tail -n 1; }
labwc_matrix() { sed -n 's:.*<calibrationMatrix>\(.*\)</calibrationMatrix>.*:\1:p' "$LABWC_RC" 2>/dev/null | head -n 1; }

show() {
  local node live
  echo "udev rule:   $RULE: $(rule_matrix || true)"
  [ -n "$(rule_matrix)" ] || echo "             (no rule; libinput uses the identity matrix)"
  if [ -n "$(labwc_matrix)" ]; then
    echo "labwc:       $LABWC_RC sets $(labwc_matrix), which overrides the udev rule."
    echo "             Run pi-carplay-touch-calibrate --matrix '...' to move it to udev."
  fi
  node=$(touch_node)
  if [ -n "$node" ]; then
    live=$(udevadm info -q property -n "$node" 2>/dev/null | sed -n 's/^LIBINPUT_CALIBRATION_MATRIX=//p')
    echo "device:      $node: ${live:-identity}"
  else
    echo "device:      no $DEVICE_NAME found"
  fi
}

write_rule() {
  local tmp
  tmp=$(mktemp)
  {
    echo "# Touch calibration for the ADS7846 panel, written by pi-carplay-touch-calibrate $(date -u +%FT%TZ)."
    echo "# Recalibrate with pi-carplay-touch-calibrate; --reset restores the default."
    echo "ACTION==\"add|change\", SUBSYSTEM==\"input\", KERNEL==\"event*\", ATTRS{name}==\"$DEVICE_NAME\", ENV{LIBINPUT_CALIBRATION_MATRIX}=\"$1\""
  } > "$tmp"
  $SUDO mkdir -p "$(dirname "$RULE")"
  $SUDO install -m 0644 "$tmp" "$RULE"
  rm -f "$tmp"
}

# A calibrationMatrix in labwc's rc.xml wins over udev; drop it so there is one source.
drop_labwc_matrix() {
  [ -n "$(labwc_matrix)" ] || return 1
  cp "$LABWC_RC" "$LABWC_RC.bak"
  sed -i '/<calibrationMatrix>/d' "$LABWC_RC"
  echo "Removed calibrationMatrix from $LABWC_RC (backup: $LABWC_RC.bak)"
}

# libinput reads the udev property only when the device appears, so re-add it:
# rebind the ADS7846 driver (labwc picks the device up again; no restart needed).
reload() {
  local labwc_changed=$1 node sys dev drv
  [ "$NO_RELOAD" = 1 ] && return 0
  [ "$labwc_changed" = 1 ] && pkill -HUP -x labwc 2>/dev/null && sleep 1
  $SUDO udevadm control --reload
  node=$(touch_node)
  [ -n "$node" ] || { echo "No $DEVICE_NAME right now; the matrix applies when it appears."; return 0; }
  sys=$(readlink -f "/sys/class/input/${node##*/}/device/device")
  dev=${sys##*/}
  drv=$(readlink -f "$sys/driver")
  if [ -d "$drv" ]; then
    echo "$dev" | $SUDO tee "$drv/unbind" > /dev/null
    echo "$dev" | $SUDO tee "$drv/bind" > /dev/null
    udevadm settle --timeout=5 2>/dev/null || true
  else
    $SUDO udevadm trigger --action=change "$node"
  fi
}

apply() {
  local m changed=0
  m=$(valid_matrix "$1") || die "not a matrix: '$1' (need six numbers: 'a b c d e f')"
  if [ "$dry_run" = 1 ]; then
    echo "Would write $RULE with LIBINPUT_CALIBRATION_MATRIX=\"$m\""
    [ -n "$(labwc_matrix)" ] && echo "Would remove calibrationMatrix from $LABWC_RC"
    return 0
  fi
  echo "Before: $(rule_matrix || true)"
  write_rule "$m"
  drop_labwc_matrix && changed=1
  reload "$changed"
  echo "After:  $m"
}

find_headunit() {
  local c
  for c in "${HEADUNIT:-}" /opt/pi-carplay/bin/headunit "$(dirname "$(readlink -f "$0")")/../raspi-headunit/build/headunit"; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return; }
  done
  command -v headunit || true
}

calibrate() {
  local hu node out code=0
  hu=$(find_headunit)
  [ -n "$hu" ] || die "headunit not found (set HEADUNIT=/path/to/headunit)"
  node=$(touch_node)
  [ -n "$node" ] || { echo "No $DEVICE_NAME found." >&2; exit 2; }
  export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
  echo "Tap the centre of each cross on the panel ($timeout s each)."
  out=$(QT_QPA_PLATFORM=wayland "$hu" --calibrate-touch --touch-device "$node" --touch-timeout "$timeout") || code=$?
  if [ "$code" -ne 0 ]; then
    echo "Calibration not completed (exit $code); nothing changed." >&2
    exit "$code"
  fi
  echo "Measured: $out"
  apply "$out"
}

case "$mode" in
  show) show ;;
  apply) apply "$matrix" ;;
  calibrate) calibrate ;;
esac
